{
  "name": "nuxt-ssr-devtools",
  "version": "0.2.3",
  "description": "Chrome DevTools companion for inspecting Nuxt SSR fetch calls",
  "license": "MIT",
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt4",
    "nuxt-module",
    "nitro",
    "vue",
    "vue3",
    "ssr",
    "server-side-rendering",
    "ssr-debugging",
    "fetch",
    "useFetch",
    "$fetch",
    "ofetch",
    "h3",
    "devtools",
    "chrome-devtools",
    "devtools-extension",
    "chrome-extension",
    "fetch-debugging",
    "fetch-inspector",
    "network-inspector",
    "debugging"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeyounagh/nuxt-fetch-inspector.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/leeyounagh/nuxt-fetch-inspector#readme",
  "bugs": {
    "url": "https://github.com/leeyounagh/nuxt-fetch-inspector/issues"
  },
  "type": "module",
  "main": "./dist/module.cjs",
  "module": "./dist/module.mjs",
  "types": "./dist/types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types.d.ts",
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "dev": "nuxt-module-build build --stub",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^3.13.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^0.8.4",
    "@nuxt/schema": "^3.13.0",
    "@types/node": "^20.11.0",
    "nuxt": "^3.13.0",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "nuxt": "^3.10.0"
  }
}
